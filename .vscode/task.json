{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "建置 EasyPatcher (Release)",
            "type": "shell",
            "command": "$msbuild = & \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -latest -products * -requires Microsoft.Component.MSBuild -find \"MSBuild\\**\\Bin\\MSBuild.exe\" | Select-Object -First 1; & $msbuild \"${workspaceFolder}\\EasyPatcher\\EasyPatcher.csproj\" /m /t:Build /p:Configuration=Release /p:Platform=AnyCPU",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "重新編譯 EasyPatcher (Release)",
            "type": "shell",
            "command": "$msbuild = & \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -latest -products * -requires Microsoft.Component.MSBuild -find \"MSBuild\\**\\Bin\\MSBuild.exe\" | Select-Object -First 1; & $msbuild \"${workspaceFolder}\\EasyPatcher\\EasyPatcher.csproj\" /m /t:Rebuild /p:Configuration=Release /p:Platform=AnyCPU",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            },
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}